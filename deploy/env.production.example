# Copiar a la raíz del repo en el servidor como `.env`
#   cp deploy/env.production.example /var/www/html/evoting/.env
# Luego completar secretos. NUNCA commitear el `.env` real.

# --- PostgreSQL (async driver) ---
DATABASE_URL=postgresql+asyncpg://evoting:CAMBIAR_PASSWORD@127.0.0.1:5432/evoting

# --- Backend ---
ENVIRONMENT=production
CORS_ORIGINS='["https://evoting.dennyrosales.com"]'
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
APP_TIMEZONE=America/Caracas
SECURE_COOKIES=true
FORCE_HTTPS_REDIRECT=false
ADMIN_MFA_REQUIRED=true
# URL-safe base64 de exactamente 32 bytes:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_ENCRYPTION_KEY=

ZKP_VERIFICATION_ENABLED=false
REQUIRE_DUAL_TALLY_APPROVAL=true
BALLOT_ISSUANCE_REQUIRED=true

# NUNCA true en producción
VOTER_TEST_MODE=false
VOTER_TEST_CODE=

# Seed admin (solo para el script seed_admin; vaciar tras usarlo)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_ORG_SLUG=
SEED_ADMIN_ORG_NAME=
SEED_ADMIN_ROLE=ELECTORAL_JUSTICE

# --- Frontend (embebidas en build; rebuild si cambian) ---
NEXT_PUBLIC_API_URL=https://evoting.dennyrosales.com
NEXT_PUBLIC_APP_TIMEZONE=America/Caracas
NEXT_PUBLIC_APP_LOCALE=es-VE
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Correo / URLs públicas ---
APP_PUBLIC_URL=https://evoting.dennyrosales.com
MAILTRAP_API_TOKEN=
MAILTRAP_API_MODE=sending
SMTP_FROM="eVoting <no-reply@dennyrosales.com>"
PASSWORD_RESET_TTL_HOURS=2
